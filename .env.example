# Copy this file to .env on the EC2 instance and replace every placeholder.
# Never commit the populated .env file.

# Browser origin allowed by the API Gateway. Do not include a trailing slash.
CORS_ALLOWED_ORIGINS=http://<EC2_PUBLIC_IP_OR_DOMAIN>

# Shared authentication settings. Use one identical secret for both services.
JWT_SECRET=<RANDOM_SECRET_AT_LEAST_32_BYTES_LONG>
JWT_EXPIRATION_MS=86400000

# Core Service - MongoDB and AI providers
MONGODB_URI=mongodb+srv://<MONGODB_USERNAME>:<MONGODB_PASSWORD>@<MONGODB_HOST>/<MONGODB_DATABASE>
DEEPSEEK_API_KEY=<DEEPSEEK_API_KEY>
OPENAI_API_KEY=<OPENAI_API_KEY>

# Shared AWS S3 storage
AWS_S3_BUCKET=<S3_BUCKET_NAME>
AWS_REGION=ap-south-1
AWS_ACCESS_KEY=<AWS_ACCESS_KEY_ID>
AWS_SECRET_KEY=<AWS_SECRET_ACCESS_KEY>

# Note Service - external MySQL database
MYSQL_URL=jdbc:mysql://<MYSQL_HOST>:<MYSQL_PORT>/<MYSQL_DATABASE>?useSSL=true&serverTimezone=UTC
MYSQL_USERNAME=<MYSQL_USERNAME>
MYSQL_PASSWORD=<MYSQL_PASSWORD>

# Optional production logging controls
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
