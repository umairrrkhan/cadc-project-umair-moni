# Core service
MONGODB_URI=mongodb://localhost:27017/umni
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_EXPIRATION_MS=86400000
DEEPSEEK_API_KEY=replace-me
OPENAI_API_KEY=replace-me
NOTE_SERVICE_URL=http://localhost:8083
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Shared AWS S3 configuration
AWS_S3_BUCKET=umni-vision-images
AWS_REGION=ap-south-1
AWS_ACCESS_KEY=replace-me
AWS_SECRET_KEY=replace-me

# Note service database
MYSQL_URL=jdbc:mysql://localhost:3306/umni_notes
MYSQL_USERNAME=replace-me
MYSQL_PASSWORD=replace-me

# Optional logging controls
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
